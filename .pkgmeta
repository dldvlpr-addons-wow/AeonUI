package-as: MuscaUI

move-folders:
  MuscaUI/MuscaUI_Bags: MuscaUI_Bags
  MuscaUI/MuscaUI_ActionBars: MuscaUI_ActionBars
  MuscaUI/MuscaUI_UnitFrames: MuscaUI_UnitFrames
  MuscaUI/MuscaUI_GroupFrames: MuscaUI_GroupFrames
  MuscaUI/MuscaUI_Nameplates: MuscaUI_Nameplates
  MuscaUI/MuscaUI_Chat: MuscaUI_Chat
  MuscaUI/MuscaUI_Minimap: MuscaUI_Minimap
  MuscaUI/MuscaUI_QuestTracker: MuscaUI_QuestTracker

ignore:
  - MuscaUI
  - docs
  - tests
  - "*.zip"
  - tools
  - Media/muscaUI.png

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
